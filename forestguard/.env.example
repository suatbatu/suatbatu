# ForestGuard server configuration. Copy to `.env` and edit.
#   cp .env.example .env
# `.env` is git-ignored. On the Pi the systemd unit points at /etc/forestguard.env.
# Every value has a safe default; uncomment only what you need to change.

# --- Server ---------------------------------------------------------------
# FG_HOST=0.0.0.0
# FG_PORT=8080
# FG_LOG_LEVEL=INFO

# --- Storage (put the DB on the SSD, not the SD card) ---------------------
FG_DB_PATH=/mnt/ssd/forestguard/forestguard.db
# Days of raw readings to keep (0 = keep forever). Pruned by the monitor.
# FG_RETENTION_DAYS=90

# --- Auth (SET THESE) -----------------------------------------------------
# Comma-separated keys your sensor nodes present as `X-API-Key`.
FG_INGEST_KEYS=change-me-node-key
# Bearer token required by the dashboard and query/control API.
FG_ADMIN_TOKEN=change-me-admin-token
# Set true ONLY on a trusted, isolated LAN to open reads without a token.
# FG_DASHBOARD_PUBLIC=false

# --- Monitoring / alerting ------------------------------------------------
# A node silent for this many seconds is flagged offline.
# FG_OFFLINE_AFTER_S=900
# Background sweep + cloud-drain cadence.
# FG_MONITOR_INTERVAL_S=30
# Minimum seconds between repeat notifications for the same node+level.
# FG_NOTIFY_THROTTLE_S=300

# --- Cloud (AWS) redundancy -----------------------------------------------
# local      = fully self-hosted, no cloud (replaces AWS)
# redundancy = also mirror every reading + event to the cloud via a durable
#              on-SSD outbox (Pi is a complete local copy; AWS is a backup)
FG_MODE=local
# FG_CLOUD_URL=https://xxxx.execute-api.eu-central-1.amazonaws.com/prod/ingest
# FG_CLOUD_KEY=your-cloud-api-key
# FG_CLOUD_BATCH_SIZE=50
# FG_CLOUD_MAX_ATTEMPTS=0        # 0 = retry forever (store-and-forward)

# --- Notifications (optional) ---------------------------------------------
# FG_TELEGRAM_TOKEN=123456:ABC...
# FG_TELEGRAM_CHAT_ID=-1001234567890
# FG_WEBHOOK_URL=https://example.com/hooks/forestguard

# --- Risk model tuning (optional; see docs/ARCHITECTURE.md) ----------------
# FG_TEMP_LOW_C=25
# FG_TEMP_HIGH_C=50
# FG_HUMIDITY_HIGH_PCT=45
# FG_HUMIDITY_LOW_PCT=15
# FG_SMOKE_BASELINE=120
# FG_SMOKE_MAX=600
# FG_SMOKE_HARD_WARNING=450
# FG_GAS_BASELINE=100
# FG_GAS_MAX=500
# FG_FLAME_THRESHOLD=1
